{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Servidor: iniciar JBoss",
      "detail": "Escolha start normal ou debug e EAP 7.1/7.4 ou Todos; nao exige aplicacao ou workspace.",
      "type": "process",
      "command": "${env:SystemRoot}/System32/WindowsPowerShell/v1.0/powershell.exe",
      "args": ["-NoProfile", "-File", "${workspaceFolder}/scripts/gerenciar-jboss.ps1", "-SelectStartMode"],
      "problemMatcher": [],
      "runOptions": { "instanceLimit": 1 },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": false }
    },
    {
      "label": "Servidor: parar JBoss",
      "detail": "Escolha EAP 7.1/7.4 ou Todos; encerra os servidores escolhidos e suas aplicacoes.",
      "type": "process",
      "command": "${env:SystemRoot}/System32/WindowsPowerShell/v1.0/powershell.exe",
      "args": ["-NoProfile", "-File", "${workspaceFolder}/scripts/gerenciar-jboss.ps1", "-Action", "Stop"],
      "problemMatcher": [],
      "runOptions": { "instanceLimit": 1 },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": false }
    },
    {
      "label": "Servidor: consultar estado JBoss",
      "detail": "Escolha EAP 7.1/7.4 ou Todos e consulte estado e identidade por servidor; nao exige aplicacao.",
      "type": "process",
      "command": "${env:SystemRoot}/System32/WindowsPowerShell/v1.0/powershell.exe",
      "args": ["-NoProfile", "-File", "${workspaceFolder}/scripts/gerenciar-jboss.ps1", "-Action", "Status"],
      "problemMatcher": [],
      "runOptions": { "instanceLimit": 1 },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": false }
    },
    {
      "label": "Servidor: criar usuario JBoss",
      "detail": "Escolha EAP 7.1/7.4; assistente oficial solicita tipo Management/Application, nome e senha usando o JDK 8 configurado.",
      "type": "process",
      "command": "${env:SystemRoot}/System32/WindowsPowerShell/v1.0/powershell.exe",
      "args": ["-NoProfile", "-File", "${workspaceFolder}/scripts/gerenciar-jboss.ps1", "-Action", "AddUser"],
      "problemMatcher": [],
      "runOptions": { "instanceLimit": 1 },
      "presentation": { "reveal": "always", "focus": true, "panel": "dedicated", "clear": false }
    },
    {
      "label": "Aplicacao: deploy no JBoss",
      "detail": "Escolha EAP ativo e aplicacao; sugere WAR/EAR encontrados em target, com selecao ou caminho manual. Nao executa build.",
      "type": "process",
      "command": "${env:SystemRoot}/System32/WindowsPowerShell/v1.0/powershell.exe",
      "args": ["-NoProfile", "-File", "${workspaceFolder}/scripts/gerenciar-jboss.ps1", "-Action", "Deploy", "-WorkspacePath", "${input:harnessWorkspacePath}", "-SelectTarget"],
      "problemMatcher": [],
      "runOptions": { "instanceLimit": 1 },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": false }
    },
    {
      "label": "Aplicacao: rollback no JBoss",
      "detail": "Escolha EAP ativo, aplicacao, deployment e release anterior gerenciada.",
      "type": "process",
      "command": "${env:SystemRoot}/System32/WindowsPowerShell/v1.0/powershell.exe",
      "args": ["-NoProfile", "-File", "${workspaceFolder}/scripts/gerenciar-jboss.ps1", "-Action", "Rollback", "-WorkspacePath", "${input:harnessWorkspacePath}", "-SelectTarget"],
      "problemMatcher": [],
      "runOptions": { "instanceLimit": 1 },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": false }
    },
    {
      "label": "Workspace: atualizar indice dos projetos",
      "detail": "Cria registros ausentes e atualiza o indice, preservando escolhas e origem dos registros existentes; abre o indice e salva copia datada. Avisos indicam o que conferir.",
      "type": "process",
      "command": "${env:SystemRoot}/System32/WindowsPowerShell/v1.0/powershell.exe",
      "args": ["-NoProfile", "-File", "${workspaceFolder}/scripts/atualizar-indice-projetos.ps1", "-WorkspacePath", "${input:harnessWorkspacePath}", "-EditorPath", "${execPath}"],
      "problemMatcher": [],
      "runOptions": { "instanceLimit": 1 },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": false }
    },
    {
      "label": "Aplicacao: preparar implementacao do lote",
      "detail": "Seleciona plan/to-do existentes e prepara o prompt para Codex ou Copilot; implementar exige GO humano registrado e execucao do prompt no cliente escolhido.",
      "type": "process",
      "command": "${env:SystemRoot}/System32/WindowsPowerShell/v1.0/powershell.exe",
      "args": ["-NoProfile", "-File", "${workspaceFolder}/scripts/preparar-implementacao.ps1", "-WorkspacePath", "${input:harnessWorkspacePath}", "-SelectTarget", "-EditorPath", "${execPath}"],
      "problemMatcher": [],
      "runOptions": { "instanceLimit": 1 },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": false }
    },
    {
      "label": "Aplicacao: analisar SonarQube",
      "detail": "Envia o projeto Maven ao Sonar configurado, solicita token oculto e coleta resultado, metricas e Quality Gate por projeto/data.",
      "type": "process",
      "command": "${env:SystemRoot}/System32/WindowsPowerShell/v1.0/powershell.exe",
      "args": ["-NoProfile", "-File", "${workspaceFolder}/scripts/analisar-sonar.ps1", "-WorkspacePath", "${input:harnessWorkspacePath}", "-SelectTarget"],
      "problemMatcher": [],
      "runOptions": { "instanceLimit": 1 },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": false }
    },
    {
      "label": "Workspace: limpar execucoes",
      "detail": "Limpe execucoes e planejamentos locais por projeto ou todos; preserve MTA externo, migracao.md, evidencias e Sonar.",
      "type": "process",
      "command": "${env:SystemRoot}/System32/WindowsPowerShell/v1.0/powershell.exe",
      "args": ["-NoProfile", "-File", "${workspaceFolder}/scripts/limpar-execucoes.ps1", "-WorkspacePath", "${input:harnessWorkspacePath}"],
      "problemMatcher": [],
      "runOptions": { "instanceLimit": 1 },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": false }
    },
    {
      "label": "Aplicacao: build Maven (Java 8)",
      "detail": "Escolha no terminal um projeto Maven do workspace e execute as fases com Java e Maven da aplicacao.",
      "type": "process",
      "command": "${env:SystemRoot}/System32/WindowsPowerShell/v1.0/powershell.exe",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/scripts/construir-aplicacao.ps1",
        "-WorkspacePath",
        "${input:harnessWorkspacePath}",
        "-SelectTarget",
        "-Goals",
        "${input:applicationBuildGoals}"
      ],
      "problemMatcher": [],
      "group": "build",
      "runOptions": {
        "instanceLimit": 1
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      }
    },
    {
      "label": "Workspace: configurar caminhos",
      "type": "process",
      "command": "${env:SystemRoot}/System32/WindowsPowerShell/v1.0/powershell.exe",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/scripts/configurar-caminhos.ps1",
        "-EditorPath",
        "${execPath}"
      ],
      "problemMatcher": [],
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "Workspace: gerar workspace",
      "type": "process",
      "command": "${env:SystemRoot}/System32/WindowsPowerShell/v1.0/powershell.exe",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/scripts/gerar-workspace.ps1"
      ],
      "problemMatcher": []
    },
    {
      "label": "MTA: conferir ambiente",
      "type": "process",
      "command": "${env:SystemRoot}/System32/WindowsPowerShell/v1.0/powershell.exe",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/scripts/conferir-ambiente.ps1",
        "-WorkspacePath",
        "${input:harnessWorkspacePath}",
        "-SelectTarget"
      ],
      "problemMatcher": []
    },
    {
      "label": "MTA: executar analise",
      "detail": "Escolha no terminal o projeto Maven do workspace ja construido e execute MTA.",
      "type": "process",
      "command": "${env:SystemRoot}/System32/WindowsPowerShell/v1.0/powershell.exe",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/scripts/executar-mta.ps1",
        "-WorkspacePath",
        "${input:harnessWorkspacePath}",
        "-SelectTarget"
      ],
      "problemMatcher": [],
      "runOptions": {
        "instanceLimit": 1
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      }
    },
    {
      "label": "MTA: acompanhar log da analise",
      "detail": "Acompanha o console.log da analise MTA em execucao, sem selecionar projeto. Ctrl+C encerra somente o leitor.",
      "type": "process",
      "command": "${env:SystemRoot}/System32/WindowsPowerShell/v1.0/powershell.exe",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/scripts/acompanhar-log-mta.ps1",
        "-Active"
      ],
      "problemMatcher": [],
      "runOptions": {
        "instanceLimit": 1
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      }
    },
    {
      "label": "MTA: acompanhar atividade interna",
      "detail": "Acompanha automaticamente o log interno da analise MTA em execucao a cada 5 segundos. Nao inicia nem interrompe MTA.",
      "type": "process",
      "command": "${env:SystemRoot}/System32/WindowsPowerShell/v1.0/powershell.exe",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/scripts/acompanhar-log-mta.ps1",
        "-Active",
        "-Detalhado"
      ],
      "problemMatcher": [],
      "runOptions": {
        "instanceLimit": 1
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      }
    },
    {
      "label": "MTA: consultar log de execucao anterior",
      "detail": "Escolha o projeto e a rodada por data/resultado para ler o log salvo, sem executar MTA.",
      "type": "process",
      "command": "${env:SystemRoot}/System32/WindowsPowerShell/v1.0/powershell.exe",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/scripts/acompanhar-log-mta.ps1",
        "-WorkspacePath",
        "${input:harnessWorkspacePath}",
        "-SelectTarget",
        "-SelectRun",
        "-Once"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      }
    },
    {
      "label": "Planejamento: priorizar issues",
      "detail": "Prepara uma fatia percentual de issues mandatory; permite recriar ou progredir sem repetir propostas anteriores.",
      "type": "process",
      "command": "${env:SystemRoot}/System32/WindowsPowerShell/v1.0/powershell.exe",
      "args": [
        "-NoProfile", "-File", "${workspaceFolder}/scripts/preparar-priorizacao.ps1",
        "-WorkspacePath", "${input:harnessWorkspacePath}", "-Interactive",
        "-EditorPath", "${execPath}"
      ],
      "problemMatcher": [],
      "runOptions": { "instanceLimit": 1 },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": false }
    },
    {
      "label": "Planejamento: planejar",
      "detail": "Cria ou retoma a proposta pelas escolhas e evidencias do migracao.md. Sem registro, orienta atualizar o indice; pergunta somente quando o contexto for ambiguo.",
      "type": "process",
      "command": "${env:SystemRoot}/System32/WindowsPowerShell/v1.0/powershell.exe",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/scripts/preparar-planejamento.ps1",
        "-WorkspacePath",
        "${input:harnessWorkspacePath}",
        "-EditorPath",
        "${execPath}"
      ],
      "problemMatcher": [],
      "runOptions": { "instanceLimit": 1 },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": false }
    },
    {
      "label": "Planejamento: criar pasta de evidencias",
      "detail": "Escolha o projeto; crie ou reabra seu indice evidencias/LEIA-ME.md, preservando o conteudo existente.",
      "type": "process",
      "command": "${env:SystemRoot}/System32/WindowsPowerShell/v1.0/powershell.exe",
      "args": [
        "-NoProfile", "-File", "${workspaceFolder}/scripts/criar-pasta-evidencias.ps1",
        "-WorkspacePath", "${input:harnessWorkspacePath}", "-SelectTarget",
        "-EditorPath", "${execPath}"
      ],
      "problemMatcher": [],
      "runOptions": { "instanceLimit": 1 },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": false }
    },
    {
      "label": "Planejamento: abrir plano e to-do",
      "detail": "Escolha projeto e planejamento por data; abra os dois documentos existentes no VS Code.",
      "type": "process",
      "command": "${env:SystemRoot}/System32/WindowsPowerShell/v1.0/powershell.exe",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/scripts/abrir-planejamento.ps1",
        "-WorkspacePath",
        "${input:harnessWorkspacePath}",
        "-SelectTarget",
        "-EditorPath",
        "${execPath}"
      ],
      "problemMatcher": [],
      "runOptions": { "instanceLimit": 1 },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": false }
    },
    {
      "label": "MTA: abrir ultimo relatorio",
      "type": "process",
      "command": "${env:SystemRoot}/System32/WindowsPowerShell/v1.0/powershell.exe",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/scripts/abrir-relatorio-mta.ps1",
        "-WorkspacePath",
        "${input:harnessWorkspacePath}",
        "-SelectTarget"
      ],
      "problemMatcher": []
    },
    {
      "label": "Workspace: conferir configuracao ao abrir",
      "type": "process",
      "command": "${env:SystemRoot}/System32/WindowsPowerShell/v1.0/powershell.exe",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/scripts/conferir-ambiente.ps1",
        "-AoAbrir",
        "-EditorPath",
        "${execPath}"
      ],
      "problemMatcher": [],
      "runOptions": {
        "runOn": "folderOpen",
        "instanceLimit": 1
      }
    }
  ],
  "inputs": [
    {
      "id": "harnessWorkspacePath",
      "type": "promptString",
      "description": "Arquivo .code-workspace em uso (caminho completo ou relativo ao harness; sem aspas)",
      "default": "jboss-mta-harness.local.code-workspace"
    },
    {
      "id": "applicationBuildGoals",
      "type": "pickString",
      "description": "Fases Maven; depois escolha o projeto no terminal (install grava no repositorio local)",
      "options": ["clean verify", "clean install", "clean package", "test", "package", "verify", "install", "clean"],
      "default": "clean verify"
    }
  ]
}
